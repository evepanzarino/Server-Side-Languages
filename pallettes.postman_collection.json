{
  "info": {
    "name": "Pallettes API Tests",
    "description": "Integration tests for the pallettes MongoDB collection: GET, GET by ID, POST, PUT by ID and DELETE by ID. Each request tests the status code and the returned payload.\n\nStart the server with `npm run dev`, then run the whole collection from top to bottom with the Collection Runner. POST create pallette saves the new pallette in collection variables, so the requests after it depend on it. Every run uses a new pallette name and deletes that pallette at the end, so the collection can be run again and again.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "missingId",
      "value": "000000000000000000000000"
    },
    {
      "key": "palletteName",
      "value": ""
    },
    {
      "key": "palletteId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "POST",
      "description": "POST /pallettes creates a pallette.",
      "item": [
        {
          "name": "POST create pallette",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{palletteName}}\",\n  \"Description\": \"Warm sunset colors\",\n  \"colorTypes\": \"red, orange\",\n  \"hexcodes\": \"#ff4500, #ffa500\",\n  \"NumberofColors\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/pallettes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pallettes"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Pallette names are unique, so each run needs a new name.",
                  "pm.collectionVariables.set(\"palletteName\", \"Sunset \" + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "",
                  "pm.test(\"Status is 201 Created\", () => {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Message says the pallette was created\", () => {",
                  "    pm.expect(res.message).to.eql(\"Pallette created\");",
                  "});",
                  "",
                  "pm.test(\"Response has the fields that were sent\", () => {",
                  "    pm.expect(res.data.name).to.eql(pm.collectionVariables.get(\"palletteName\"));",
                  "    pm.expect(res.data.Description).to.eql(\"Warm sunset colors\");",
                  "    pm.expect(res.data.colorTypes).to.eql(\"red, orange\");",
                  "    pm.expect(res.data.hexcodes).to.eql(\"#ff4500, #ffa500\");",
                  "    pm.expect(res.data.NumberofColors).to.eql(2);",
                  "});",
                  "",
                  "pm.test(\"MongoDB gave the pallette a 24-character _id\", () => {",
                  "    pm.expect(res.data._id).to.match(/^[a-f0-9]{24}$/);",
                  "});",
                  "",
                  "pm.test(\"select() left __v out of the new pallette\", () => {",
                  "    pm.expect(res.data).to.not.have.property(\"__v\");",
                  "});",
                  "",
                  "// Save the new pallette's details for the requests below.",
                  "if (res.data) {",
                  "    pm.collectionVariables.set(\"palletteId\", res.data._id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "POST pallette - missing required fields (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"NumberofColors\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/pallettes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pallettes"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "",
                  "pm.test(\"Status is 400 Bad Request\", () => {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test(\"Message says validation failed\", () => {",
                  "    pm.expect(res.message).to.eql(\"Validation failed\");",
                  "});",
                  "",
                  "pm.test(\"errors lists the message for each missing field\", () => {",
                  "    pm.expect(res.errors).to.eql({",
                  "        name: \"name is required\",",
                  "        Description: \"Description is required\",",
                  "        colorTypes: \"colorTypes is required\",",
                  "        hexcodes: \"hexcodes is required\",",
                  "    });",
                  "});",
                  "",
                  "pm.test(\"No pallette is returned\", () => {",
                  "    pm.expect(res).to.not.have.property(\"data\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST pallette - name already taken (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{palletteName}}\",\n  \"Description\": \"Forest greens\",\n  \"colorTypes\": \"green\",\n  \"hexcodes\": \"#228b22\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/pallettes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pallettes"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "const name = pm.collectionVariables.get(\"palletteName\");",
                  "",
                  "pm.test(\"Status is 409 Conflict\", () => {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "",
                  "pm.test(\"Message says the name is taken\", () => {",
                  "    pm.expect(res.message).to.eql('name \"' + name + '\" is already taken');",
                  "});",
                  "",
                  "pm.test(\"No pallette is returned\", () => {",
                  "    pm.expect(res).to.not.have.property(\"data\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "GET",
      "description": "GET /pallettes lists every pallette.",
      "item": [
        {
          "name": "GET all pallettes",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/pallettes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pallettes"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "",
                  "pm.test(\"Status is 200 OK\", () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Message says all pallettes were returned\", () => {",
                  "    pm.expect(res.message).to.eql(\"Get all pallettes\");",
                  "});",
                  "",
                  "pm.test(\"data is a list with at least one pallette\", () => {",
                  "    pm.expect(res.data).to.be.an(\"array\").that.is.not.empty;",
                  "});",
                  "",
                  "pm.test(\"List includes the new pallette with the details that were sent\", () => {",
                  "    const pallette = res.data.find((p) => p._id === pm.collectionVariables.get(\"palletteId\"));",
                  "    pm.expect(pallette).to.be.an(\"object\");",
                  "    pm.expect(pallette.name).to.eql(pm.collectionVariables.get(\"palletteName\"));",
                  "    pm.expect(pallette.Description).to.eql(\"Warm sunset colors\");",
                  "    pm.expect(pallette.NumberofColors).to.eql(2);",
                  "});",
                  "",
                  "pm.test(\"Every pallette has a name, Description, colorTypes, hexcodes and NumberofColors\", () => {",
                  "    res.data.forEach((pallette) => {",
                  "        pm.expect(pallette).to.include.keys(\"name\", \"Description\", \"colorTypes\", \"hexcodes\", \"NumberofColors\");",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "GET by ID",
      "description": "GET /pallettes/:id returns one pallette and the colors it has.",
      "item": [
        {
          "name": "GET pallette by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/pallettes/{{palletteId}}",
              "host": [
                "{{baseUrl}}"
              ],
