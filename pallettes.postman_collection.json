    {
      "name": "PUT by ID",
      "description": "PUT /pallettes/:id changes only the fields sent in the body.",
      "item": [
        {
          "name": "PUT update pallette by ID",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"Description\": \"Cool ocean colors\",\n  \"NumberofColors\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/pallettes/{{palletteId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pallettes",
                "{{palletteId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "",
                  "pm.test(\"Status is 200 OK\", () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Message says the pallette was updated\", () => {",
                  "    pm.expect(res.message).to.eql(\"Pallette updated\");",
                  "});",
                  "",
                  "pm.test(\"Description and NumberofColors have the new values\", () => {",
                  "    pm.expect(res.data.Description).to.eql(\"Cool ocean colors\");",
                  "    pm.expect(res.data.NumberofColors).to.eql(3);",
                  "});",
                  "",
                  "pm.test(\"Fields that weren't sent stayed the same\", () => {",
                  "    pm.expect(res.data.name).to.eql(pm.collectionVariables.get(\"palletteName\"));",
                  "    pm.expect(res.data.colorTypes).to.eql(\"red, orange\");",
                  "    pm.expect(res.data.hexcodes).to.eql(\"#ff4500, #ffa500\");",
                  "});",
                  "",
                  "pm.test(\"It is still the same pallette\", () => {",
                  "    pm.expect(res.id).to.eql(pm.collectionVariables.get(\"palletteId\"));",
                  "    pm.expect(res.data._id).to.eql(pm.collectionVariables.get(\"palletteId\"));",
                  "});"
                ]
              }
            }
          ]
        },
